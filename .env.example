# Copy to .env and adjust. Native development reads it directly (backend/config/settings.py);
# docker compose passes it into the app container and overrides a few values (see below).

# --- Application ----------------------------------------------------------------
# Every URL users open Pickup under, comma separated (scheme, host and port if not
# default). Allowed hosts, CSRF trusted origins and secure cookies are derived from it;
# use https URLs only once a TLS proxy is in front. With DEBUG=true the Vite dev server
# (localhost:5173) and runserver (localhost:8000) are added automatically.
APP_URLS=http://localhost:8080
# Port published on the host by docker compose.
APP_PORT=8080

# Address(es) of a TLS proxy in front of Pickup (comma separated IPs or CIDR ranges).
# Only from these nginx accepts X-Forwarded-For/-Proto, i.e. the client's address and
# HTTPS. Required with https URLs in APP_URLS. Empty: clients connect directly.
TRUSTED_PROXIES=

# Long random string (at least 40 characters; Pickup refuses to start otherwise), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# With DEBUG=true a fixed development key is used while this is still the placeholder.
SECRET_KEY=change-me
# true for native development (runserver, Vite). docker compose always sets false.
DEBUG=true
# Serve the Django admin under /admin. Defaults to the value of DEBUG; set true to
# expose it in the Docker setup as well (its login is rate-limited by nginx).
# ADMIN_ENABLED=false
# With https APP_URLS, HSTS is sent for a year. Only enable these if every subdomain
# of the domain is HTTPS-only (and, for preload, you want the browser preload list).
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
TIME_ZONE=Europe/Berlin
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created by `manage.py ensure_admin` if the user does not exist)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Only used when the user is created; change it later with
#   uv run python manage.py set_password admin               (native)
#   docker compose exec app python manage.py set_password admin   (Docker)
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------------- database
# sqlite (file backend/db.sqlite3) or postgres. docker compose always runs Postgres
# with the values below and sets DB_TYPE=postgres, DB_HOST=db and DEBUG=false inside the
# container. Set a real DB_PASSWORD before the first `docker compose up`.
DB_TYPE=sqlite
DB_NAME=pickup
DB_USER=pickup
DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --------------------------------------------------------------------------- e-mail
# Share links are mailed to members who enter an address. Empty EMAIL_HOST: mails are
# printed to the server console with DEBUG=true and not sent at all otherwise.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
# For Gmail an app password, not the account password.
EMAIL_HOST_PASSWORD=
# Sender address of outgoing mails.
DEFAULT_FROM_EMAIL=pickup@localhost

# --------------------------------------------------------------------------- storage
# Writable data directory: uploaded media (DATA_DIR/media) and upload temp files.
# Default: backend/data; the container uses its /data volume.
# DATA_DIR=

# --------------------------------------------------------------------------- backups
# docker compose runs a nightly backup into the "backups" volume (docker/backup.sh):
# a pg_dump plus a snapshot of the uploaded media (unchanged files are hard-linked, so
# every snapshot is complete but only new files take space). Time of day in TIME_ZONE,
# and how many days of backups to keep.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

# --------------------------------------------------------------------------- server
# Gunicorn worker processes in the app container; each handles one request at a time
# and needs roughly 50-150 MB RAM. Rule of thumb: 2 x CPU cores + 1. Default: 3.
# GUNICORN_WORKERS=3
# Seconds a request may take (gunicorn and nginx). Finalizing a chunked upload copies
# the whole file once; raise this for uploads of many GB on slow disks. Default: 300.
# GUNICORN_TIMEOUT=300
