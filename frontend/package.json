{
  "name": "pickup",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint && eslint . && knip",
    "format": "prettier --write --experimental-cli src/",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format:check": "prettier --check src/",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:coverage",
    "size": "size-limit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/vue": "^1.64.0",
    "@tanstack/vue-query": "^5.105.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.43.0",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.90.0",
    "prettier": "3.9.10",
    "size-limit": "^14.3.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.16.1",
  "size-limit": [
    {
      "name": "JS",
      "path": [
        "dist/assets/*.js",
        "!dist/assets/de-*.js"
      ],
      "limit": "182 kB"
    },
    {
      "name": "German texts (loaded only in German)",
      "path": "dist/assets/de-*.js",
      "limit": "12 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "17 kB"
    }
  ]
}
