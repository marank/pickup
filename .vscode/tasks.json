{
  // Everyday commands. Every task calls a recipe of the justfile, the one place the commands
  // live; CI (.github/workflows/build.yaml) calls the same recipes.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Django (:8000) and Vite (:5173) dev servers",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "just dev-backend",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "just dev-frontend",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "check",
      "detail": "Everything CI checks: backend, deploy settings, frontend, workflows",
      "type": "shell",
      "command": "just check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "check: changed",
      "detail": "Before a commit: only what the changed files can break",
      "type": "shell",
      "command": "just check-changed",
      "problemMatcher": []
    },
    {
      "label": "check: backend",
      "type": "shell",
      "command": "just check-backend",
      "problemMatcher": []
    },
    {
      "label": "check: frontend",
      "type": "shell",
      "command": "just check-frontend",
      "problemMatcher": []
    },
    {
      "label": "api: types",
      "detail": "After API changes: OpenAPI schema → frontend/openapi.json → src/api/schema.d.ts",
      "type": "shell",
      "command": "just api-types",
      "problemMatcher": []
    },
    {
      "label": "django: makemigrations",
      "type": "shell",
      "command": "just migrations",
      "problemMatcher": []
    },
    {
      "label": "django: worker",
      "detail": "Background jobs (mails, cleanup, catching up on previews); needs DB_TYPE=postgres in .env — with SQLite jobs run right away",
      "type": "shell",
      "command": "just worker",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "django: messages",
      "detail": "After changing server texts: collect them in locale/de/django.po (translate the empty ones), compile django.mo",
      "type": "shell",
      "command": "just messages",
      "problemMatcher": []
    },
    {
      "label": "django: migrate",
      "type": "shell",
      "command": "just migrate",
      "problemMatcher": []
    },
    {
      "label": "db: start dev postgres",
      "detail": "Postgres for native development (DB_TYPE=postgres, DB_HOST=localhost in .env)",
      "type": "shell",
      "command": "just db-up",
      "problemMatcher": []
    },
    {
      "label": "docker: up",
      "detail": "Build and start the production-like stack (http://localhost:8080)",
      "type": "shell",
      "command": "just docker-up",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "just docker-down",
      "problemMatcher": []
    }
  ]
}
