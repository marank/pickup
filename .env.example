# Configuration for docker compose: copy to .env and fill in. compose.yml sets the wiring
# itself (DEBUG=false, DB_TYPE=postgres, DB_HOST=db). Native development: CONTRIBUTING.md.

# --- Application ----------------------------------------------------------------
# Every URL users open Pickup under, comma separated (scheme, host and port if not
# default). Allowed hosts, CSRF trusted origins and secure cookies are derived from it;
# use https URLs only once a TLS proxy is in front.
APP_URLS=http://localhost:8080
# Port published on the host.
APP_PORT=8080

# Address(es) of a TLS proxy in front of Pickup (comma separated IPs or CIDR ranges).
# Only from these nginx accepts X-Forwarded-For/-Proto, i.e. the client's address and
# HTTPS. Required with https URLs in APP_URLS. Empty: clients connect directly.
TRUSTED_PROXIES=

# Long random string (at least 40 characters; Pickup refuses to start otherwise), e.g.:
#   openssl rand -hex 32
SECRET_KEY=change-me
# Key for the keyed hashes of e-mail addresses (privacy mode stores nothing else).
# At least 32 random characters; generate like SECRET_KEY. NEVER change it once people
# have joined: stored hashes would no longer match and nobody could request their link.
EMAIL_HASH_KEY=change-me
# Development only; compose.yml always sets false.
# DEBUG=false
# Serve the Django admin under /admin (its login is rate-limited by nginx). Default: off.
# ADMIN_ENABLED=false
# Days a browser stays logged in to its pickups (personal link or joining) without using
# them; every day it opens one starts the count again. Afterwards the personal link is
# needed again.
SESSION_DAYS=28
TIME_ZONE=Europe/Berlin
# Language when the browser asks for none we offer (mails, server messages); the app itself
# follows the browser (English or German).
LANGUAGE_CODE=en-us
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created on start if the user does not exist) ---------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Only used when the user is created; change it later with
#   docker compose exec app python manage.py set_password admin
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------------- database
# PostgreSQL in the db container, created with these values. Set a real DB_PASSWORD
# before the first `docker compose up`; changing it later has no effect.
# compose.yml sets DB_TYPE=postgres and DB_HOST=db.
# DB_TYPE=postgres
DB_NAME=pickup
DB_USER=pickup
DB_PASSWORD=change-me
# Seconds a database connection is kept for the next request (0: a new one each time).
DB_CONN_MAX_AGE=60
# DB_HOST=localhost
# DB_PORT=5432

# --------------------------------------------------------------------------- e-mail
# Personal links and invitations are mailed (invitations need this). Empty EMAIL_HOST:
# no mails are sent.
EMAIL_HOST=
# Encryption: STARTTLS on port 587 (EMAIL_USE_TLS=true, the default) or implicit TLS on
# port 465 (EMAIL_USE_SSL=true, then EMAIL_USE_TLS=false). Only one of the two.
EMAIL_PORT=587
EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# Seconds to wait for the mail server before giving up (the mail is then logged as failed).
# EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
# For Gmail an app password, not the account password.
EMAIL_HOST_PASSWORD=
# Sender address of outgoing mails.
DEFAULT_FROM_EMAIL=pickup@localhost

# --------------------------------------------------------------------------- creating pickups
# Who may create pickups: everyone (default), code (only with one of PICKUP_CREATION_CODES,
# asked for every time a pickup is created) or none (the start page has no create button).
PICKUP_CREATION=everyone
# Comma-separated codes for PICKUP_CREATION=code, e.g. 1234-5678-9012,ABCD-EFGH-IJKL.
# Spaces and upper/lower case don't matter. Required with PICKUP_CREATION=code.
PICKUP_CREATION_CODES=
# Name the Pickup apps show for this server in their server list, e.g. "Photos of the
# sailing club". Empty: its host name. `manage.py server_link` prints a link that adds this
# server to the apps (with PICKUP_CREATION=code it carries a code, so share it with care).
SERVER_NAME=

# --------------------------------------------------------------------------- storage
# Media files are served through an access check at /api/files/<id>/; Django then hands
# them to nginx (X-Accel-Redirect). Leave as it is.
# MEDIA_ACCEL_REDIRECT=true
# Storage limits, so nobody fills up the disk (uploads beyond them are refused with a
# message). Sizes like 20GB, 500MB or 0 for unlimited (binary units: 1GB = 1024 MB).
# PICKUP_STORAGE_LIMIT: all files of one pickup; MEMBER_STORAGE_LIMIT: one participant's
# folders. Uploads in progress count with their full size. An admin can override both per
# pickup: `python manage.py storage_limits <pickup id> --pickup 50GB --member unlimited`
# ("default" goes back to these values; without options it shows usage and limits).
# PICKUP_STORAGE_LIMIT=20GB
# MEMBER_STORAGE_LIMIT=5GB
# Writable data directory: uploaded media (DATA_DIR/media) and upload temp files.
# The container uses its /data volume.
# DATA_DIR=

# --------------------------------------------------------------------------- backups
# docker compose runs a nightly backup into the "backups" volume (docker/backup.sh):
# a pg_dump plus a snapshot of the uploaded media (unchanged files are hard-linked, so
# every snapshot is complete but only new files take space). Time of day in TIME_ZONE,
# and how many days of backups to keep.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

# --------------------------------------------------------------------------- server
# Gunicorn worker processes in the app container; each needs roughly 50-150 MB RAM.
# Rule of thumb: 2 x CPU cores + 1. Default: 3.
# GUNICORN_WORKERS=3
# Threads per worker: requests each worker handles at the same time. Long ones (ZIP
# downloads, finalizing large uploads) then don't hold up everyone else. Each thread may
# keep a database connection: workers x threads must stay below Postgres' max_connections
# (100). Default: 8.
# GUNICORN_THREADS=8
# Seconds a request may take (gunicorn and nginx). Finalizing a chunked upload copies
# the whole file once; raise this for uploads of many GB on slow disks. Default: 300.
# GUNICORN_TIMEOUT=300
